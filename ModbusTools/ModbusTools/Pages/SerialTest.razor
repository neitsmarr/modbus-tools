@page "/serial"
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Serial Test</PageTitle>

<h1>Serial Test</h1>

<p>Open a serial (COM) port with the browser's Web Serial API and send a test byte sequence.</p>

@if (isSupported is null)
{
    <p><em>Checking Web Serial support...</em></p>
}
else if (isSupported == false)
{
    <div class="alert alert-warning" role="alert">
        The Web Serial API is not available in this browser. Use a desktop Chromium-based browser
        (Chrome, Edge or Opera) and open the app over HTTPS or on localhost.
    </div>
}
else
{
    <p role="status">
        Status: <strong>@(isConnected ? $"Connected ({portName}, {baudRate} baud)" : "Disconnected")</strong>
    </p>

    <div class="mb-3">
        <label for="baudRate" class="form-label">Baud rate</label>
        <select id="baudRate" class="form-select w-auto" @bind="baudRate" disabled="@(isConnected || isBusy)">
            @foreach (var rate in BaudRates)
            {
                <option value="@rate">@rate</option>
            }
        </select>
    </div>

    <p>Test sequence: <code>@TestSequenceHex</code></p>

    <div class="d-flex gap-2 mb-3">
        <button class="btn btn-primary" @onclick="ConnectAsync" disabled="@(isConnected || isBusy)">Connect</button>
        <button class="btn btn-success" @onclick="SendAsync" disabled="@(!isConnected || isBusy)">Send</button>
        <button class="btn btn-outline-secondary" @onclick="DisconnectAsync" disabled="@(!isConnected || isBusy)">Disconnect</button>
    </div>

    @if (message is not null)
    {
        <div class="alert @(isError ? "alert-danger" : "alert-success")" role="alert">@message</div>
    }
}

@code {
    private static readonly byte[] TestSequence = [0x01, 0x03, 0x00, 0x00, 0x00, 0x01];
    private static readonly string TestSequenceHex = string.Join(" ", TestSequence.Select(b => b.ToString("X2")));
    private static readonly int[] BaudRates = [9600, 19200, 38400, 57600, 115200];

    private IJSObjectReference? module;
    private DotNetObjectReference<SerialTest>? selfRef;

    private bool? isSupported;
    private bool isConnected;
    private bool isBusy;
    private int baudRate = 9600;
    private string? portName;
    private string? message;
    private bool isError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        module = await JS.InvokeAsync<IJSObjectReference>("import", "./Pages/SerialTest.razor.js");
        isSupported = await module.InvokeAsync<bool>("isSupported");
        StateHasChanged();
    }

    private async Task ConnectAsync()
    {
        isBusy = true;
        message = null;
        try
        {
            selfRef ??= DotNetObjectReference.Create(this);
            portName = await module!.InvokeAsync<string>("connect", baudRate, selfRef);
            isConnected = true;
            ShowSuccess($"Opened {portName} at {baudRate} baud.");
        }
        catch (JSException ex)
        {
            ShowError($"Connect failed: {FirstLine(ex.Message)}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SendAsync()
    {
        isBusy = true;
        try
        {
            await module!.InvokeVoidAsync("send", TestSequence);
            ShowSuccess($"Sent {TestSequence.Length} bytes: {TestSequenceHex}");
        }
        catch (JSException ex)
        {
            ShowError($"Send failed: {FirstLine(ex.Message)}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DisconnectAsync()
    {
        await module!.InvokeVoidAsync("disconnect");
        isConnected = false;
        portName = null;
        ShowSuccess("Port closed.");
    }

    [JSInvokable]
    public void OnDeviceDisconnected()
    {
        isConnected = false;
        portName = null;
        ShowError("The serial device was disconnected.");
        StateHasChanged();
    }

    private void ShowSuccess(string text) => (message, isError) = (text, false);

    private void ShowError(string text) => (message, isError) = (text, true);

    // JS errors arrive as "message\nstack"; only the message is useful here.
    private static string FirstLine(string text) => text.Split('\n', 2)[0];

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            // Release the port so it can be reopened after navigating back.
            await module.InvokeVoidAsync("disconnect");
            await module.DisposeAsync();
        }

        selfRef?.Dispose();
    }
}
